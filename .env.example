# TypeSafe Jev (decision model)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Jevops intake / policy
JEVOPS_HOST=0.0.0.0
JEVOPS_PORT=8080
JEVOPS_DB=jevops.db
JEVOPS_SERVICES=services.toml
JEVOPS_NOISE=noise.txt
JEVOPS_MIN_LEVEL=ERROR
JEVOPS_TOP_K=3
JEVOPS_PAGE_MIN_CONFIDENCE=0.8
JEVOPS_PAGE_MIN_HUMAN=0.7
JEVOPS_COOLDOWN_SECONDS=1800
JEVOPS_DRY_RUN=true

# Text model for Mode B query explanations (OpenAI-compatible; Jevium values work)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=
TEXT_MODEL=
TEXT_MODEL_REASONING=none

# Mode B query budgets
JEVOPS_QUERY_CHUNK_SIZE=40
JEVOPS_QUERY_SUB=4
JEVOPS_QUERY_DEPTH=4
JEVOPS_QUERY_LEAF=5
JEVOPS_QUERY_IMP=0.5
JEVOPS_QUERY_MAX_LEAVES=50
JEVOPS_QUERY_MAX_ROUNDS=3

# Elasticsearch
ES_URL=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_VERIFY_TLS=true
ES_INDEX_SOURCE=logs-*
ES_INDEX_DECISIONS=jevops-decisions
JEVOPS_ES_POLL_SECONDS=10
JEVOPS_ES_POLL_SIZE=200

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=
GRAFANA_USER=
GRAFANA_PASSWORD=
GRAFANA_DS_NAME=Jevops Elasticsearch

# Notifiers
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
JEVOPS_WEBHOOK_URL=
